{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/session_sync.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/tools/session_sync.py\"",
            "timeout": 120,
            "statusMessage": "Syncing lessons from GitHub..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/cloud_autosync.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/tools/cloud_autosync.py\" 2>/dev/null || true",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
